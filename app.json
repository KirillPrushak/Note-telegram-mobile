{
  "expo": {
    "name": "Note Telegram",
    "slug": "Note-telegram-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notetelegrammobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kirillprushak.notetelegram"
    },
    "android": {
      "package": "com.kirillprushak.notetelegram",
      "adaptiveIcon": {
        "backgroundColor": "#F1E1DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0a0a0a"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
